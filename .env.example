# Variables de entorno de Nodo Social — NUNCA subir el .env real (está en .gitignore).
# Copia este archivo a .env.local y rellena los valores.

# Supabase (datos, login, multi-empresa)
# URL y anon key son públicas (van al navegador) → prefijo NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role: SOLO en el servidor, acceso total, nunca al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Cerebro (solo servidor)
ANTHROPIC_API_KEY=

# Meta / Instagram (OAuth de la app de Nodo, solo servidor)
META_APP_ID=
META_APP_SECRET=
