# Variables de entorno de Nodo Social — NUNCA subir el .env real (está en .gitignore).
# Copia este archivo a .env.local y rellena los valores.

# Supabase (datos, login, multi-empresa)
# URL y anon key son públicas (van al navegador) → prefijo NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role: SOLO en el servidor, acceso total, nunca al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Cerebro (solo servidor)
ANTHROPIC_API_KEY=
# Modelo del asistente (opcional). Por defecto claude-sonnet-5-5 (bueno y barato).
# Alternativas: claude-haiku-5-5 (más barato) o claude-opus-5-5 (máxima calidad).
ANTHROPIC_MODEL=

# Meta / Instagram (OAuth de la app de Nodo, solo servidor) — para "Conectar Instagram" (más adelante)
META_APP_ID=
META_APP_SECRET=

# Publicador automático (solo servidor)
# CRON_SECRET: lo genera Vercel; protege la ruta /api/cron/publicar (Vercel añade el header solo).
CRON_SECRET=
# Cuenta de Instagram para la PRIMERA prueba (la de Nodo). Mismo token permanente de contenidonodo.
# Más adelante cada cliente conectará la suya por OAuth y esto dejará de ser necesario.
IG_USER_ID=
IG_TOKEN=
